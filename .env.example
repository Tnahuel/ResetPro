# Solo hace falta para correr en tu computadora. En Vercel, DATABASE_URL la
# inyecta la integracion con Neon (Storage) y el resto es opcional.

# PostgreSQL local o de Neon. Si no la definis y corres local, se usa un SQLite
# temporal (solo para probar rapido; en Vercel SIEMPRE usa Postgres).
DATABASE_URL=postgresql://usuario:password@localhost:5432/resetpro

# Opcional. Si no la definis se deriva de DATABASE_URL (igual de secreta).
JWT_SECRET_KEY=

# Opcional. Cuando pasa a false NO se cargan los datos de ejemplo.
SEED_DEMO_DATA=true

# Opcional: crea este admin real si la base esta vacia.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrador

# Zona horaria para calcular "hoy" en turnos y paneles.
APP_TIMEZONE=America/Argentina/Cordoba

# --- Recuperacion de contrasena por email (opcional) ---
# Sin esto, "olvide mi contrasena" igual funciona: el pedido le llega al administrador,
# que genera un enlace desde su panel. Elegi UNA de las dos opciones:

# Opcion A: Resend (https://resend.com) - API por HTTPS
RESEND_API_KEY=
# Remitente. Con tu dominio verificado en Resend, ej: ResetPro <no-reply@tudominio.com>
MAIL_FROM=

# Opcion B: SMTP (Gmail con contrasena de aplicacion, Brevo, etc.)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# (MAIL_FROM tambien se usa con SMTP)

# URL publica del sitio para armar el enlace del email. En Vercel no hace falta:
# se toma sola. Definila si usas un dominio propio.
APP_BASE_URL=
