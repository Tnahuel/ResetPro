# Solo hace falta para correr en tu computadora. En Vercel, DATABASE_URL la
# inyecta la integracion con Neon (Storage) y el resto es opcional.

# PostgreSQL local o de Neon. Si no la definis y corres local, se usa un SQLite
# temporal (solo para probar rapido; en Vercel SIEMPRE usa Postgres).
DATABASE_URL=postgresql://usuario:password@localhost:5432/resetpro

# Opcional. Si no la definis se deriva de DATABASE_URL (igual de secreta).
JWT_SECRET_KEY=

# Opcional. Cuando pasa a false NO se cargan los datos de ejemplo.
SEED_DEMO_DATA=true

# Opcional: crea este admin real si la base esta vacia.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrador

# Zona horaria para calcular "hoy" en turnos y paneles.
APP_TIMEZONE=America/Argentina/Cordoba
